---
import Layout from "../layouts/Layout.astro";
import EconiscorePage from "../components/pages/econiscore";

export const prerender = true;

const title = "Econiscore — Web Performance Intelligence | MSDO Case Study";
const description =
  "How MSDO designed Econiscore, a web performance benchmarking platform for media organizations, spanning product strategy, UX, data visualization, and design systems.";
const ogImage =
  "https://payload.cargocollective.com/1/0/18737/12273661/01_header_1200.png";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: "Econiscore — Web Performance Intelligence",
  about: "Product strategy, UX, product design, data visualization, and design systems for Econiscore",
  creator: { "@type": "Organization", name: "MSDO" },
  author: { "@type": "Person", name: "Mark Strehlow" },
  dateCreated: "2022",
  keywords:
    "web performance intelligence, product design, UX strategy, data visualization, design systems, media technology",
  url: "https://msdo.us/econiscore",
};
---

<Layout title={title} description={description} type="article" image={ogImage} jsonLd={jsonLd}>
  <Fragment slot="head">
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </Fragment>
  <EconiscorePage client:load />
</Layout>
